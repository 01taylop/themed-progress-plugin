{
  "name": "themed-progress-plugin",
  "description": "A Webpack plugin featuring emoji-themed progress bars for a fun and engaging build process.",
  "version": "1.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01taylop/themed-progress-plugin.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf lib && rollup -c",
    "example": "tsx ./scripts/example",
    "prepublish": "yarn test --coverage && yarn build && yarn test:integration",
    "release": "changeset publish",
    "test": "jest src/",
    "test:integration": "yarn node --experimental-vm-modules $(yarn bin jest) tests/"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@jest/globals": "30.5.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "jest": "30.5.2",
    "knip": "6.45.1",
    "rimraf": "6.1.4",
    "rollup": "4.68.3",
    "rollup-plugin-dts": "6.5.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "webpack": "5.112.2"
  },
  "author": "Patrick Taylor <hello@patricktaylor.dev>",
  "keywords": [
    "emoji",
    "loading",
    "plugin",
    "progress",
    "themed",
    "webpack"
  ],
  "license": "MIT",
  "packageManager": "yarn@4.19.0"
}
